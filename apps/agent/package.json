{
  "name": "@h2class/agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:tool-schemas && pnpm run test:jobs",
    "test:jobs": "node --import ./test/register-loader.mjs --test test/jobs.test.ts",
    "test:tool-schemas": "node --import ./test/register-loader.mjs --test test/tools-schema.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply h2class-agent --local",
    "db:migrate:remote": "wrangler d1 migrations apply h2class-agent --remote"
  },
  "dependencies": {
    "@h2class/shared": "workspace:*",
    "hono": "^4.12.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.111.0"
  }
}
