# Copy to .env.production after the two backend Worker URLs are known.
# VITE_* values are public and compiled into the browser bundle.
VITE_CORE_URL=https://h2class-api.your-workers-subdomain.workers.dev
VITE_AGENT_URL=https://h2class-agent.your-workers-subdomain.workers.dev
VITE_AGENT_MODEL=replace-with-your-vendor-model-id
