{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "h2class-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "h2class",
      // Replace with the real id printed by `wrangler d1 create h2class` before deploying.
      // Local dev (`pnpm dev:api`) works fine with this placeholder.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
